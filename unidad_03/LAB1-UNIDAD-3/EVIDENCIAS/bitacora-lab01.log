2026-11-09 00:16:21.256 CST [26900] user=postgres db=comercial app=psql client=::1 LOG:  sentencia: CREATE OR REPLACE FUNCTION auditoria.registrar_cambio_cliente()
\tRETURNS TRIGGER
\tLANGUAGE plpgsql
\tSECURITY DEFINER
\tSET search_path = pg_catalog, public
\tAS $$
\tBEGIN
\t    INSERT INTO auditoria.cambios_clientes (
\t        usuario_sesion,
\t        usuario_efectivo,
\t        aplicacion,
\t        ip_cliente,
\t        operacion,
\t        id_cliente,
\t        valores_antes,
\t        valores_despues
\t    )
\t    VALUES (
\t        session_user,
\t        current_user,
\t        current_setting('application_name'),
\t        inet_client_addr(),
\t        TG_OP,
\t        CASE
\t            WHEN TG_OP = 'DELETE' THEN OLD.id
\t            ELSE NEW.id
\t        END,
\t        CASE
\t            WHEN TG_OP IN ('UPDATE', 'DELETE')
\t            THEN to_jsonb(OLD)
\t            ELSE NULL
\t        END,
\t        CASE
\t            WHEN TG_OP IN ('INSERT', 'UPDATE')
\t            THEN to_jsonb(NEW)
\t            ELSE NULL
\t        END
\t    );
\t
\t    RETURN COALESCE(NEW, OLD);
\tEND;
\t$$;
